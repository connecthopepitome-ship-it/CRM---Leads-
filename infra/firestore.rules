rules_version = '2';
// LLD-common §6 / HLD §11: clients never talk to Firestore directly. All reads and writes go through
// the API (Admin SDK, which bypasses these rules) so RBAC, validation and audit are always enforced.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
