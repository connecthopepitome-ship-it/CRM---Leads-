# SaleSphere CRM Master Environment Variables
# Copy to .env for local overrides; NEVER commit real secrets or production credentials.

# ---- Local development ----
PORT=8787                              # API dev server port
DEV_ADMIN_PASSWORD=ChangeMe!2026       # Temporary admin password seeded on start (must change on first login)
NODE_ENV=development                   # development | production | test
APP_ORIGIN=http://localhost:5173       # Public origin of the PWA (e.g. https://crm.yourcompany.com)
API_BASE=/api/v1
CLIENT_NAME=SaleSphere                 # Used for Google Drive root folder name: "SaleSphere – <CLIENT_NAME>"
GCLOUD_PROJECT=                        # Optional Google Cloud Project ID (used when running against Firestore)
GOOGLE_APPLICATION_CREDENTIALS=        # Path to local serviceAccountKey.json (if using Firestore in development)

# ---- Production Secrets (GCP Secret Manager / Cloudflare Secrets) ----
JWT_PRIVATE_JWK=                       # Ed25519 private JWK (JSON string) for signing access tokens
EDGE_HMAC_SECRET=                      # Shared secret with Cloudflare Worker edge proxy (≥ 32 random characters)
DATA_ENC_KEY=                          # 32 random bytes, base64-encoded for AES-256-GCM token sealing
GOOGLE_CLIENT_SECRET=                  # Google OAuth2 Client Secret for Gmail / Drive API sync

# ---- Google Workspace Integration (Drive, Gmail, Picker, Sheets) ----
GOOGLE_CLIENT_ID=                      # Google OAuth2 Client ID
GOOGLE_REDIRECT_URI=                   # OAuth2 callback URL (e.g. https://crm.yourcompany.com/api/v1/admin/google/callback)
GOOGLE_PICKER_API_KEY=                 # Google Drive Picker API Key
GOOGLE_APPSCRIPT_URL=                  # Web App URL for Google AppScript Drive bridge
GOOGLE_APPSCRIPT_SECRET=               # Shared secret configured in infra/appscript/Code.gs

# ---- Notifications & Document Services ----
FCM_VAPID_PUBLIC_KEY=                  # Firebase Web Push VAPID key
PDF_FUNCTION_URL=                      # Optional Cloud Run URL for server-side Chromium PDF rendering

# ---- Operational Tunables & Rate Limits ----
EMAIL_DAILY_LIMIT=450                  # Daily Gmail sending quota cap
LEAD_FORM_RATE_PER_MIN=60              # Public lead capture rate limit per IP per minute
LEAD_FORM_MIN_FILL_MS=3000             # Minimum form completion duration anti-bot check
AUDIT_MAX_RANGE_DAYS=366               # Maximum allowable date range for audit log queries
FILE_MAX_MB=25                         # Maximum file upload size limit
JUNK_RETENTION_MONTHS=3                # Retention period before hard-purging junk leads

# ---- Cloudflare Worker / D1 Deployment ----
# Set via Cloudflare dashboard or `wrangler secret put <KEY>`:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# D1 Database binding: env.DB (configured in wrangler.jsonc)
