# SaleSphere environment variables (CLAUDE.md §7). Copy to .env for local overrides; never commit real values.
# In production the four SECRETS below come from Secret Manager (functions `secrets:`), everything else from
# functions params / .env.<project>. The API refuses to start in production if a secret is missing.

# ---- Local development only ----
PORT=8787                              # API dev server port
DEV_ADMIN_PASSWORD=ChangeMe!2026       # temporary admin password seeded on start; must be changed at first sign-in
# FIRESTORE_EMULATOR_HOST=localhost:8080 # use the Firestore emulator instead of the in-memory DB
# SS_RECORD_QUERIES=/abs/path/infra/query-shapes.jsonl  # record query shapes for infra/gen-indexes.mjs

# ---- Runtime ----
NODE_ENV=development                   # production is forced by apps/api/src/functions.ts
APP_ORIGIN=http://localhost:5173       # public origin of the PWA, e.g. https://crm.<client>.com (share links, OAuth return)
API_BASE=/api/v1
CLIENT_NAME=Client                     # used for the Google Drive root folder name "SaleSphere – <name>"
GCLOUD_PROJECT=                        # set automatically on Cloud Functions; needed for seed-cli

# ---- SECRETS (Secret Manager in production) ----
JWT_PRIVATE_JWK=                       # Ed25519 private JWK (JSON) for access tokens; see RUNBOOK §Secrets to generate
EDGE_HMAC_SECRET=                      # shared with the Cloudflare Pages Function; ≥ 32 random bytes
GOOGLE_CLIENT_SECRET=                  # OAuth client secret (Google Cloud console → Credentials)
DATA_ENC_KEY=                          # 32 random bytes, base64 — AES-256-GCM sealing of share-link tokens

# ---- Google integration (FR-037 – FR-043) ----
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=                   # https://crm.<client>.com/api/v1/admin/google/callback
GOOGLE_PICKER_API_KEY=
FCM_VAPID_PUBLIC_KEY=                  # web push (FR-079)
PDF_FUNCTION_URL=                      # URL of the private `pdf` function (Cloud Run)

# ---- Tunables (defaults shown) ----
EMAIL_DAILY_LIMIT=450                  # Gmail sending cap per day
LEAD_FORM_RATE_PER_MIN=60              # public form submissions per IP per minute
LEAD_FORM_MIN_FILL_MS=3000             # bot check: minimum time to fill the form
AUDIT_MAX_RANGE_DAYS=366
FILE_MAX_MB=25
JUNK_RETENTION_MONTHS=3                # FR-090 purge

# ---- Cloudflare Pages project (set in the Pages dashboard, not here) ----
# API_ORIGIN=https://api-xxxxx-el.a.run.app
# EDGE_HMAC_SECRET=<same as above>
